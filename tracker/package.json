{
  "name": "productive-day",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "node build.mjs && wrangler deploy",
    "db:init": "wrangler d1 execute productive-day --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute productive-day --local --file schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250913.0",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "wrangler": "4.36.0"
  }
}
