{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["worker", "web", "../lib/life", "../app/life/LifeApp.tsx", "../app/life/_components"]
}
